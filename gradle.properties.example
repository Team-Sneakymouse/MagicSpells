# Copy to .gradle/gradle.properties in this repo (gitignored), or put in ~/.gradle/gradle.properties.
# Never commit real credentials.
#
# Publish version is derived from the git HEAD commit (yyyy.MM.dd-<12-char-hash>), not from this file.

# --- sneakyrp Maven (Reposilite) ---
# https://maven.sneakyrp.com/releases
# For Reposilite, sneakyrpUsername is the token name; sneakyrpPassword is its secret.
sneakyrpUsername=YOUR_UPLOAD_USERNAME
sneakyrpPassword=YOUR_UPLOAD_TOKEN
